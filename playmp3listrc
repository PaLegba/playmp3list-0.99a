.KEY_MAPPINGS
#=============================================
# function		list of keys
#=============================================
previous_song		Z Y
play_song		X
pause_song		C
stop_song		V
next_song		B
rewind_song		N
fast_forward_song	M
#up			
#down			
#home			
#end			
#page_up		
#page_down		
#play_selected		
increase_volume		> . + =
decrease_volume		< , - _
toggle_shuffle		S
toggle_repeat		R
toggle_full_path	F
toggle_time_remaining	T
toggle_alpha		A
jump_root		/
jump_home		~
#jump_updir		
jump_user1		1
jump_user2		2
jump_user3		3
jump_user4		4
jump_user5		5
jump_user6		6
jump_user7		7
jump_user8		8
jump_user9		9
jump_user0		0
search			`
show_ID3_tag		I
help			? H
#redraw			
quit			Q

.SETTINGS
#=============================================
# setting		value
#=============================================
auto_play		false
auto_shuffle		false
auto_repeat		false
auto_alpha		true
full_path		false
time_remaining		false
ID3v1			false

# Specify additional parameters to send to mpg123
mpg123_params		

# Specify priority to re-nice mpg123 to
mpg123_priority		0

# Specify initial PCM audio volume
#PCM_volume		100

# Specify where the ten jump keys will take you
